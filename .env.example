# Copie a .env y cambie los valores. Nunca suba .env al repositorio.
# --- docker-compose.full.yml ---
DB_PASSWORD=cambie_esta_clave
# --- API (local o Render) ---
# DATABASE_URL=postgresql://custodia:custodia@localhost:5432/custodia
# DB_SSL=true                      # solo si usa la URL EXTERNA de Render
# Genere uno con:  openssl rand -hex 48
JWT_SECRET=
# NODE_ENV=production
# Administrador inicial (se crea una sola vez si no existe ese correo/usuario):
# ADMIN_EMAIL=admin@su-dominio.example
# ADMIN_PASSWORD=                  # >= 12 caracteres, letras y números
# ADMIN_USERNAME=admin
# Datos ficticios de demostración (solo con base vacía). En producción se exige DEMO_PASSWORD
# fuerte o se genera una aleatoria que se imprime una vez en el log:
# SEED_DEMO=false
# DEMO_PASSWORD=
# Archivos en PostgreSQL (BYTEA): límite por archivo (KB) y cuota total (MB)
# STORAGE_DRIVER=db                # db | local
# STORAGE_MAX_KB=5120
# STORAGE_QUOTA_MB=300
